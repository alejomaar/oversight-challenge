# Copy this file to secrets.toml (same directory) and fill in real values.
# secrets.toml is gitignored — never commit real tokens.
#
# Alternatively, set these as environment variables (API_BASE_URL, API_TOKEN)
# before running `streamlit run app.py` — env vars take precedence over this file.

API_BASE_URL = "https://your-api-id.execute-api.us-east-1.amazonaws.com/prod"
API_TOKEN = "your-token-here"
